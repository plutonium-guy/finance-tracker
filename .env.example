PORT=8080
DB_PATH=./finance.db
SEED_DEMO=true

# Optional: add transactions by messaging a Telegram bot.
# Get a token from @BotFather. Leave blank to disable the bot.
TELEGRAM_BOT_TOKEN=
# Optional: restrict adds to a single chat id (your own). Blank = any chat.
# Also used as the default target for the outbound push API.
TELEGRAM_ALLOWED_CHAT=

# Optional: bearer token for the protected API endpoints
# (POST /api/push, POST /api/gmail/sync). Callers send it as `Authorization: Bearer <token>`.
API_PUSH_TOKEN=

# Optional: import credit-card spend emails from Gmail into transactions.
# Enable 2-Step Verification on the Google account, then create an App Password
# (Google Account → Security → App passwords) and use it below — NOT your login password.
GMAIL_IMAP_USER=            # your.address@gmail.com
GMAIL_IMAP_PASSWORD=        # 16-char Gmail app password
# Optional tuning:
GMAIL_SYNC_INTERVAL=6h      # how often to poll (Go duration; default 6h)
GMAIL_LOOKBACK_DAYS=7       # how far back to search each run
GMAIL_DEFAULT_CATEGORY=Miscellaneous
# Comma-separated From-address substrings to match. Blank = built-in list of
# common Indian bank card-alert senders (HDFC/ICICI/Axis/SBI/Kotak/AU).
GMAIL_CC_SENDERS=
# GMAIL_IMAP_HOST=imap.gmail.com:993
# GMAIL_MAILBOX=INBOX
